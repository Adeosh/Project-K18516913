<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Krepim.Mobile.Features.Profile.Views.ChangePasswordPopup"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <Border BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 16" WidthRequest="320" Padding="20">
        <VerticalStackLayout Spacing="12">

            <Label Text="Смена пароля" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextColor}" HorizontalOptions="Center" />

            <Label x:Name="ErrorLabel" TextColor="{StaticResource AccentColor}" FontSize="12" IsVisible="False" HorizontalTextAlignment="Center" />

            <Border Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 8" Padding="12,0" HeightRequest="45">
                <Entry x:Name="OldPasswordEntry" Placeholder="Текущий пароль" IsPassword="True" TextColor="{StaticResource TextColor}" />
            </Border>

            <Border Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 8" Padding="12,0" HeightRequest="45">
                <Entry x:Name="NewPasswordEntry" Placeholder="Новый пароль" IsPassword="True" TextColor="{StaticResource TextColor}" />
            </Border>

            <Border Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 8" Padding="12,0" HeightRequest="45">
                <Entry x:Name="ConfirmPasswordEntry" Placeholder="Повторите пароль" IsPassword="True" TextColor="{StaticResource TextColor}" />
            </Border>

            <Button Text="ОБНОВИТЬ" Clicked="OnSubmitClicked" BackgroundColor="{StaticResource TextColor}" TextColor="{StaticResource SurfaceColor}" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" Margin="0,10,0,0" />
            <Button Text="ОТМЕНА" Clicked="OnCancelClicked" BackgroundColor="Transparent" TextColor="{StaticResource TextPlaceholderColor}" HeightRequest="40" />

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>