<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:Krepim.Mobile.Features.Catalog.ViewModels"
             x:Class="Krepim.Mobile.Features.Catalog.Views.ProductDetailPage"
             x:DataType="viewmodels:ProductDetailViewModel"
             Title="{Binding Product.Sku}"
             BackgroundColor="{StaticResource BgColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,16,16,40">

            <ActivityIndicator IsVisible="{Binding IsLoading}" 
                   IsRunning="{Binding IsLoading}" 
                   Color="{StaticResource AccentColor}" 
                   HorizontalOptions="Center" 
                   Margin="0,50" />

            <VerticalStackLayout IsVisible="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}" Spacing="20">

                <VerticalStackLayout Spacing="12">
                    <Border BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                        <Image Source="{Binding MainImage}" Aspect="AspectFit" HeightRequest="250" />
                    </Border>

                    <CollectionView ItemsSource="{Binding Product.ImageUrls}" HeightRequest="56">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 8" WidthRequest="56" HeightRequest="56" BackgroundColor="{StaticResource SurfaceColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProductDetailViewModel}}, Path=SetMainImageCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Image Source="{Binding .}" Aspect="AspectFit" Margin="4" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <FlexLayout Wrap="Wrap" AlignItems="Center">
                    <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource BgColor}" StrokeShape="RoundRectangle 6" Padding="8,4" Margin="0,0,8,8">
                        <Label Text="{Binding Product.Sku, StringFormat='Арт: {0}'}" FontSize="12" TextColor="{StaticResource TextPlaceholderColor}" />
                    </Border>

                    <Border IsVisible="{Binding Product.Brand, Converter={toolkit:IsNotNullConverter}}" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource BgColor}" StrokeShape="RoundRectangle 6" Padding="8,4" Margin="0,0,8,8">
                        <Label Text="{Binding Product.Brand}" FontSize="12" TextColor="{StaticResource AccentColor}" />
                    </Border>

                    <Border StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8,4" Margin="0,0,8,8" BackgroundColor="Transparent" Stroke="{StaticResource BorderColor}">
                        <Label Text="{Binding AvailableStock, StringFormat='В наличии: {0:N0} шт.'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextColor}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding AvailableStock}" Value="0">
                                    <Setter Property="Text" Value="Нет в наличии" />
                                    <Setter Property="TextColor" Value="#DC3545" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </FlexLayout>

                <Label Text="{Binding Product.Name}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextColor}" LineHeight="1.2" />

                <Border BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12" Padding="16">
                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">

                            <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding CurrentPrice, StringFormat='{0:N2}'}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                                <Label Text="₽" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextColor}" VerticalOptions="Center" />
                                <Label Text="{Binding UnitText, StringFormat='/ {0}'}" FontSize="12" TextColor="{StaticResource TextPlaceholderColor}" VerticalOptions="End" Margin="0,0,0,3" />
                            </HorizontalStackLayout>

                            <Border Grid.Column="1" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 6" BackgroundColor="{StaticResource BgColor}" Padding="2">
                                <HorizontalStackLayout>
                                    <Button Text="Поштучно" 
                                            Command="{Binding SetUnitModeSingleCommand}"
                                            BackgroundColor="{Binding IsPackageMode, Converter={toolkit:BoolToObjectConverter TrueObject=Transparent, FalseObject={StaticResource SurfaceColor}}}"
                                            TextColor="{Binding IsPackageMode, Converter={toolkit:BoolToObjectConverter TrueObject={StaticResource TextPlaceholderColor}, FalseObject={StaticResource TextColor}}}"
                                            FontSize="12" HeightRequest="32" Padding="12,0" CornerRadius="4" />

                                    <Button Text="{Binding Product.SalesStep, StringFormat='Оптом x{0}'}" 
                                            Command="{Binding SetUnitModePackageCommand}"
                                            BackgroundColor="{Binding IsPackageMode, Converter={toolkit:BoolToObjectConverter TrueObject={StaticResource SurfaceColor}, FalseObject=Transparent}}"
                                            TextColor="{Binding IsPackageMode, Converter={toolkit:BoolToObjectConverter TrueObject={StaticResource TextColor}, FalseObject={StaticResource TextPlaceholderColor}}}"
                                            FontSize="12" HeightRequest="32" Padding="12,0" CornerRadius="4" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">

                            <Border Grid.Column="0" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" StrokeShape="RoundRectangle 8" Padding="4">
                                <HorizontalStackLayout VerticalOptions="Center" Spacing="8">
                                    <Button Text="-" Command="{Binding DecreaseQuantityCommand}" BackgroundColor="Transparent" TextColor="{StaticResource TextPlaceholderColor}" FontSize="18" WidthRequest="36" HeightRequest="36" Padding="0" />
                                    <Label Text="{Binding Quantity}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextColor}" VerticalOptions="Center" HorizontalTextAlignment="Center" WidthRequest="40" />
                                    <Button Text="+" Command="{Binding IncreaseQuantityCommand}" BackgroundColor="Transparent" TextColor="{StaticResource TextPlaceholderColor}" FontSize="18" WidthRequest="36" HeightRequest="36" Padding="0" />
                                </HorizontalStackLayout>
                            </Border>

                            <Button Grid.Column="1" 
                                    Text="{Binding CanAddToCart, Converter={toolkit:BoolToObjectConverter TrueObject='В корзину', FalseObject='Пусто'}}"
                                    Command="{Binding AddToBasketCommand}"
                                    BackgroundColor="{Binding CanAddToCart, Converter={toolkit:BoolToObjectConverter TrueObject={StaticResource AccentColor}, FalseObject={StaticResource BorderColor}}}"
                                    TextColor="{StaticResource SurfaceColor}"
                                    FontAttributes="Bold" CornerRadius="8" HeightRequest="46" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                    <Label Text="ОПТОВЫЕ СКИДКИ" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPlaceholderColor}" TextTransform="Uppercase" />

                    <FlexLayout BindableLayout.ItemsSource="{Binding Product.PriceTiers}" Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" StrokeShape="RoundRectangle 20" Padding="12,6" Margin="0,0,8,8">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{Binding MinQuantity, StringFormat='от {0} шт.'}" FontSize="12" TextColor="{StaticResource TextPlaceholderColor}" />
                                        <Label Text="{Binding Price, StringFormat='{0:N2} ₽'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="16" Margin="0,16,0,0">

                    <Label Text="Характеристики" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Product.Attributes}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, *">
                                    <Label Grid.Column="0" Text="{Binding Key}" FontSize="13" TextColor="{StaticResource TextPlaceholderColor}" />
                                    <Label Grid.Column="1" Text="{Binding Value}" FontSize="13" TextColor="{StaticResource TextColor}" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,8" />

                    <Label Text="Описание" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                    <Label Text="{Binding Product.Description}" FontSize="13" TextColor="{StaticResource TextPlaceholderColor}" LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>