<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:Krepim.Mobile.Features.Auth.ViewModels"
             x:Class="Krepim.Mobile.Features.Auth.Views.RegisterPage"
             x:DataType="viewmodels:RegisterViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource BgColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="24,40,24,24" VerticalOptions="Center">

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,0,0,10">
                <Label Text="Регистрация" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextColor}" HorizontalTextAlignment="Center" />
                <Label Text="Создайте аккаунт для покупок" FontSize="16" TextColor="{StaticResource TextColor}" Opacity="0.7" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border BackgroundColor="#1A9E2F1F" 
                    Stroke="{StaticResource AccentColor}" 
                    StrokeShape="RoundRectangle 8" 
                    Padding="16"
                    Margin="0,0,0,16"
                    IsVisible="{Binding ErrorMessage, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}}">

                <Label Text="{Binding ErrorMessage}" 
                       TextColor="{StaticResource AccentColor}" 
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
            </Border>

            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Электронная почта" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                    <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource BgColor}" StrokeShape="RoundRectangle 12" HeightRequest="52" Padding="16,0">
                        <Entry Placeholder="mail@mail.com" Keyboard="Email" Text="{Binding Email}" TextColor="{StaticResource TextColor}" PlaceholderColor="{StaticResource TextPlaceholderColor}" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="Номер телефона" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                        <Label Text="(необязательно)" FontSize="12" TextColor="{StaticResource TextPlaceholderColor}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource BgColor}" StrokeShape="RoundRectangle 12" HeightRequest="52" Padding="16,0">
                        <Entry Placeholder="+7 (999) 000-00-00" Keyboard="Telephone" Text="{Binding PhoneNumber}" TextColor="{StaticResource TextColor}" PlaceholderColor="{StaticResource TextPlaceholderColor}" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Пароль" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                    <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource BgColor}" StrokeShape="RoundRectangle 12" HeightRequest="52" Padding="16,0">
                        <Entry Placeholder="••••••••" IsPassword="True" Text="{Binding Password}" TextColor="{StaticResource TextColor}" PlaceholderColor="{StaticResource TextPlaceholderColor}" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Подтверждение пароля" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                    <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource BgColor}" StrokeShape="RoundRectangle 12" HeightRequest="52" Padding="16,0">
                        <Entry Placeholder="••••••••" IsPassword="True" Text="{Binding ConfirmPassword}" TextColor="{StaticResource TextColor}" PlaceholderColor="{StaticResource TextPlaceholderColor}" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <Button Text="ЗАРЕГИСТРИРОВАТЬСЯ" 
                    Command="{Binding RegisterCommand}"
                    BackgroundColor="{StaticResource AccentColor}" 
                    TextColor="{StaticResource SurfaceColor}" 
                    FontAttributes="Bold" 
                    FontSize="16"
                    HeightRequest="56" 
                    CornerRadius="8" 
                    Margin="0,16,0,0" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,10,0,0">
                <Label Text="Уже есть аккаунт?" TextColor="{StaticResource TextColor}" Opacity="0.7" FontSize="15" VerticalOptions="Center" />
                <Label Text="Войти" TextColor="{StaticResource AccentColor}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>