<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:Krepim.Mobile.Features.Auth.ViewModels"
             x:Class="Krepim.Mobile.Features.Auth.Views.RegisterPage"
             x:DataType="viewmodels:RegisterViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="15" VerticalOptions="Center">

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,0,0,15">
                <Label Text="РЕГИСТРАЦИЯ" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource TextColor}" HorizontalOptions="Center" />
                <Label Text="Создание нового профиля" FontSize="14" TextColor="{StaticResource TextMutedColor}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border Stroke="{StaticResource ErrorColor}" StrokeThickness="1" BackgroundColor="#1AFFE4E4" 
                    IsVisible="{Binding ErrorMessage, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" 
                    Padding="15" StrokeShape="RoundRectangle 12">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorColor}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            </Border>

            <VerticalStackLayout Spacing="12">

                <VerticalStackLayout Spacing="5">
                    <Label Text="Электронная почта" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                    <Entry Text="{Binding Email}" Placeholder="mail@mail.com" Keyboard="Email" IsEnabled="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Номер телефона" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                        <Label Text="(необязательно)" FontSize="12" TextColor="{StaticResource TextMutedColor}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Entry Text="{Binding PhoneNumber}" Placeholder="+7 (999) 000-00-00" Keyboard="Telephone" IsEnabled="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Пароль" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                    <Entry Text="{Binding Password}" Placeholder="••••••••" IsPassword="True" IsEnabled="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Подтверждение пароля" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                    <Entry Text="{Binding ConfirmPassword}" Placeholder="••••••••" IsPassword="True" IsEnabled="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}" />
                </VerticalStackLayout>

            </VerticalStackLayout>

            <Button Text="Создать аккаунт" Command="{Binding RegisterCommand}" BackgroundColor="{StaticResource AccentColor}" TextColor="{StaticResource White}" CornerRadius="12" HeightRequest="50" Margin="0,10,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsLoading}" Value="True">
                        <Setter Property="Text" Value="Регистрация..." />
                        <Setter Property="Opacity" Value="0.7" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,15,0,0">
                <Label Text="Уже есть доступ?" TextColor="{StaticResource TextMutedColor}" VerticalOptions="Center" />
                <Label Text="Войти в систему" TextColor="{StaticResource AccentColor}" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>