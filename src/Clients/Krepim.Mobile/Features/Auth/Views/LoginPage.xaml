<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Krepim.Mobile.Features.Auth.ViewModels"
             x:Class="Krepim.Mobile.Features.Auth.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="24,60,24,24" VerticalOptions="Center">

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,0,0,20">
                <Label FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="КРЕПИМ" TextColor="{StaticResource TextColor}" />
                            <Span Text=".ПРО" TextColor="{StaticResource AccentColor}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="Вход в личный кабинет" FontSize="16" TextColor="{StaticResource TextColor}" Opacity="0.7" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="16">
                <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" StrokeShape="RoundRectangle 8" HeightRequest="56" Padding="16,0">
                    <Entry Placeholder="E-mail" 
                           Keyboard="Email" 
                           Text="{Binding Username}" 
                           TextColor="{StaticResource TextColor}" 
                           PlaceholderColor="{StaticResource TextPlaceholderColor}" 
                           VerticalOptions="Center" />
                </Border>

                <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" StrokeShape="RoundRectangle 8" HeightRequest="56" Padding="16,0">
                    <Entry Placeholder="Пароль" 
                           IsPassword="True" 
                           Text="{Binding Password}" 
                           TextColor="{StaticResource TextColor}" 
                           PlaceholderColor="{StaticResource TextPlaceholderColor}" 
                           VerticalOptions="Center" />
                </Border>

                <Label Text="Забыли пароль?" TextColor="{StaticResource AccentColor}" FontSize="14" HorizontalOptions="End">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <Button Text="ВОЙТИ" 
                    Command="{Binding LoginCommand}"
                    BackgroundColor="{StaticResource AccentColor}" 
                    TextColor="{StaticResource SurfaceColor}" 
                    FontAttributes="Bold" 
                    FontSize="16"
                    HeightRequest="56" 
                    CornerRadius="8" 
                    Margin="0,16,0,0" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,20,0,0">
                <Label Text="Нет аккаунта?" TextColor="{StaticResource TextColor}" Opacity="0.7" FontSize="15" VerticalOptions="Center" />
                <Label Text="Создать" TextColor="{StaticResource AccentColor}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>