<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:Krepim.Mobile.Features.Home.ViewModels"
             x:Class="Krepim.Mobile.Features.Home.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Shell.NavBarIsVisible="False" 
             BackgroundColor="{StaticResource BgColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Grid HeightRequest="240">
                <Image Source="banner_2.png" Aspect="AspectFill" />

                <Border BackgroundColor="#CC392012" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 8" 
                        Padding="12,8"
                        Margin="16,10,16,0"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        IsVisible="{Binding IsAuthenticated}">

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Image Source="location.png" 
                               WidthRequest="18" 
                               HeightRequest="18" 
                               VerticalOptions="Center" 
                               Aspect="AspectFit">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource BgColor}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Text="{Binding DeliveryAddress}" 
                               TextColor="{StaticResource BgColor}" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               LineBreakMode="TailTruncation" 
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <VerticalStackLayout Padding="16,0,16,24" Spacing="16" VerticalOptions="End">

                    <Border BackgroundColor="#CC392012" 
                            StrokeThickness="0" 
                            StrokeShape="RoundRectangle 8" 
                            Padding="12,8"
                            HorizontalOptions="Center">

                        <Label FontSize="22" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="КРЕПИМ" TextColor="{StaticResource BgColor}" />
                                    <Span Text=".ПРО" TextColor="{StaticResource Sand}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>

                    <Border Stroke="{StaticResource BorderColor}" 
                            BackgroundColor="{StaticResource SurfaceColor}" 
                            StrokeShape="RoundRectangle 12" 
                            HeightRequest="50" 
                            Padding="15,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CategoryTappedCommand}" CommandParameter="" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Image Source="search.png" 
                                   WidthRequest="20" 
                                   HeightRequest="20" 
                                   VerticalOptions="Center" 
                                   Aspect="AspectFit" />
                            <Label Text="Найти болты, гайки, анкера..." 
                                   FontSize="14" 
                                   TextColor="{StaticResource TextPlaceholderColor}" 
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="20" Padding="16,24,16,40">

                <Label Text="Категории" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />

                <CollectionView ItemsSource="{Binding Categories}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="16" HorizontalItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:PromoCategory">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=CategoryTappedCommand}" CommandParameter="{Binding Title}" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Image Source="{Binding ImageSource}" 
                                       Aspect="AspectFit" 
                                       HeightRequest="65" 
                                       HorizontalOptions="Center" />

                                <Label Text="{Binding Title}" FontSize="11" TextColor="{StaticResource TextColor}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Наши партнеры" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />

                <ScrollView Orientation="Horizontal" 
                            HorizontalScrollBarVisibility="Never" 
                            HeightRequest="80">

                    <HorizontalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Partners}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:Partner">
                                <Border Stroke="{StaticResource BorderColor}" 
                                        BackgroundColor="{StaticResource SurfaceColor}" 
                                        StrokeShape="RoundRectangle 8" 
                                        WidthRequest="130" 
                                        Padding="10">
                                    <Image Source="{Binding ImageSource}" 
                                           Aspect="AspectFit" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>