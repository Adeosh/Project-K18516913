<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Krepim.Mobile.Features.Home.ViewModels"
             x:Class="Krepim.Mobile.Features.Home.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="Главная"
             BackgroundColor="{StaticResource BgColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="20">

            <Grid HeightRequest="250">
                <Image Source="banner_2.png" Aspect="AspectFill" />
                <BoxView Color="#66000000" />

                <VerticalStackLayout Padding="20" VerticalOptions="Center" Spacing="10">
                    <Label Text="Профессиональный крепеж" TextColor="White" FontSize="26" FontAttributes="Bold" />
                    <Label Text="Более 10 000 позиций на складе с доставкой в день заказа." TextColor="White" FontSize="14" />

                    <Button Text="В каталог" Command="{Binding CategoryTappedCommand}" CommandParameter="" 
                            BackgroundColor="{StaticResource AccentColor}" TextColor="White" 
                            HorizontalOptions="Start" CornerRadius="8" Padding="20,10" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Grid>

            <Border Margin="15,0" Padding="10" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 12">
                <CollectionView ItemsSource="{Binding Categories}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="10" HorizontalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:PromoCategory">
                            <Border Stroke="Transparent" BackgroundColor="Transparent" Padding="5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=CategoryTappedCommand}" CommandParameter="{Binding Title}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                    <Image Source="{Binding ImageSource}" HeightRequest="45" WidthRequest="45" Aspect="AspectFit" />
                                    <Label Text="{Binding Title}" FontSize="10" TextColor="{StaticResource TextColor}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <VerticalStackLayout Padding="20" Spacing="10">
                <Label Text="Магазин Крепим.ПРО" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                <Label Text="Мы специализируемся на предоставлении высококачественных метизных изделий, удовлетворяя потребности как крупных промышленных предприятий, так и индивидуальных клиентов." 
                       TextColor="{StaticResource TextMutedColor}" FontSize="14" LineHeight="1.2" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>