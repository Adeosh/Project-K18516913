<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:Krepim.Mobile.Features.Ordering.ViewModels"
             xmlns:wrappers="clr-namespace:Krepim.Mobile.Features.Ordering.ViewModels.Wrappers"
             x:Class="Krepim.Mobile.Features.Ordering.Views.OrderDetailPage"
             x:DataType="viewmodels:OrderDetailViewModel"
             Title="Детали заказа"
             BackgroundColor="{StaticResource BgColor}">

    <Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource AccentColor}" HorizontalOptions="Center" VerticalOptions="Center" />

        <ScrollView IsVisible="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}">
            <VerticalStackLayout Spacing="16" Padding="16,16,16,40">

                <Label Text="← Назад" TextColor="{StaticResource TextPlaceholderColor}" FontAttributes="Bold" FontSize="14">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Border BackgroundColor="#1A9E2F1F" Stroke="{StaticResource AccentColor}" StrokeShape="RoundRectangle 8" Padding="16" IsVisible="{Binding ErrorMessage, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}}">
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource AccentColor}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </Border>

                <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" StrokeShape="RoundRectangle 16" Padding="16">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Заказ оформлен" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                        <Border Grid.Row="0" Grid.Column="1" Stroke="Transparent" BackgroundColor="{StaticResource BgColor}" StrokeShape="RoundRectangle 8" Padding="10,6" VerticalOptions="Center">
                            <Label Text="{Binding DisplayStatus}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource AccentColor}" />
                        </Border>
                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Order.Id, StringFormat='№ {0}'}" FontSize="12" TextColor="{StaticResource TextPlaceholderColor}" FontAttributes="Bold" />
                    </Grid>
                </Border>

                <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Дата заказа" FontSize="12" TextColor="{StaticResource TextPlaceholderColor}" />
                                <Label Text="{Binding Order.CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                <Label Text="Итого к оплате" FontSize="12" TextColor="{StaticResource TextPlaceholderColor}" HorizontalOptions="End" />
                                <Label Text="{Binding Order.TotalPrice, StringFormat='{0:N0} ₽'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource AccentColor}" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Адрес доставки" FontSize="12" TextColor="{StaticResource TextPlaceholderColor}" />
                            <Label Text="{Binding Order.FullAddress}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding Order.QrCodeUrl, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}}" Spacing="8" HorizontalOptions="Center" Margin="0,8,0,0">
                            <Label Text="QR-КОД ДЛЯ ПОЛУЧЕНИЯ" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPlaceholderColor}" HorizontalOptions="Center" />
                            <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource BgColor}" StrokeShape="RoundRectangle 12" Padding="8">
                                <WebView Source="{Binding Order.QrCodeUrl}" WidthRequest="140" HeightRequest="140" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding CanBePaid}" Spacing="8">
                    <Button Text="{Binding IsPaymentLoading, Converter={toolkit:BoolToObjectConverter TrueObject='Переход к оплате...', FalseObject='Перейти к оплате'}}" 
                            Command="{Binding PayCommand}"
                            IsEnabled="{Binding IsPaymentLoading, Converter={toolkit:InvertedBoolConverter}}"
                            BackgroundColor="{StaticResource AccentColor}" 
                            TextColor="{StaticResource SurfaceColor}" 
                            FontAttributes="Bold" 
                            HeightRequest="48" 
                            CornerRadius="8" />

                    <Label Text="{Binding PaymentError}" TextColor="{StaticResource AccentColor}" FontSize="12" HorizontalTextAlignment="Center" IsVisible="{Binding PaymentError, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}}" />
                </VerticalStackLayout>

                <Label Text="Состав заказа" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextColor}" Margin="0,8,0,0" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrderItems}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="wrappers:OrderItemWrapper">
                            <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" StrokeShape="RoundRectangle 12" Padding="12">
                                <Grid ColumnDefinitions="56, *, Auto" ColumnSpacing="12" VerticalOptions="Center">

                                    <Border Grid.Column="0" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 8" WidthRequest="56" HeightRequest="56">
                                        <Image Source="{Binding ProductImageUrl}" Aspect="AspectFit" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding ProductName}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextColor}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Dto.Quantity, StringFormat='Количество: {0} шт.'}" FontSize="11" TextColor="{StaticResource TextPlaceholderColor}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="{Binding TotalPrice, StringFormat='{0:N0} ₽'}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextColor}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>