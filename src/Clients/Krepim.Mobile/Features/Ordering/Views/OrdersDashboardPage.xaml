<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:wrappers="clr-namespace:Krepim.Mobile.Features.Ordering.ViewModels.Wrappers"
             xmlns:viewmodels="clr-namespace:Krepim.Mobile.Features.Ordering.ViewModels"
             x:Class="Krepim.Mobile.Features.Ordering.Views.OrdersDashboardPage"
             x:DataType="viewmodels:OrdersDashboardViewModel"
             Title="Управление заказами"
             BackgroundColor="{StaticResource BgColor}">

    <Grid RowDefinitions="Auto, Auto, *">

        <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="4">
            <Label Text="Управление заказами" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
            <Label Text="Обработка входящих заказов и контроль доставки." FontSize="14" TextColor="{StaticResource TextPlaceholderColor}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" 
                Stroke="{StaticResource BorderColor}" 
                BackgroundColor="{StaticResource BgColor}" 
                StrokeShape="RoundRectangle 8" 
                HeightRequest="44" 
                Padding="12,0"
                Margin="16,0,16,16">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                <Image Grid.Column="0" 
                       Source="search.svg" 
                       WidthRequest="18" 
                       HeightRequest="18" 
                       VerticalOptions="Center" 
                       Aspect="AspectFit">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource TextPlaceholderColor}" />
                    </Image.Behaviors>
                </Image>

                <Entry Grid.Column="1" 
                       Text="{Binding SearchQuery}" 
                       Placeholder="Поиск по номеру, адресу или почте..." 
                       PlaceholderColor="{StaticResource TextPlaceholderColor}"
                       TextColor="{StaticResource TextColor}"
                       VerticalOptions="Center"
                       BackgroundColor="Transparent"
                       FontSize="14"
                       ClearButtonVisibility="WhileEditing" />
            </Grid>
        </Border>

        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource AccentColor}" HorizontalOptions="Center" VerticalOptions="Center" />

        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding FilteredOrders}" 
                        IsVisible="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}"
                        Margin="16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="wrappers:OrderListItemWrapper">
                    <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" StrokeShape="RoundRectangle 12" Padding="16" Margin="0,0,0,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:OrdersDashboardViewModel}}, Path=GoToDetailsCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding ShortId, StringFormat='№ {0}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentColor}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding DisplayStatus}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextColor}" HorizontalOptions="End" />

                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Dto.CustomerEmail}" FontSize="14" TextColor="{StaticResource TextColor}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Dto.TotalPrice, StringFormat='{0:N0} ₽'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextColor}" HorizontalOptions="End" />

                            <Label Grid.Row="2" Grid.Column="0" Text="{Binding Dto.FullAddress}" FontSize="12" TextColor="{StaticResource TextPlaceholderColor}" LineBreakMode="TailTruncation" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Dto.CreatedAt, StringFormat='{0:dd.MM.yy HH:mm}'}" FontSize="12" TextColor="{StaticResource TextPlaceholderColor}" HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>