<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Krepim.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Krepim.Mobile"
    xmlns:home="clr-namespace:Krepim.Mobile.Features.Home.Views"
    Title="КРЕПИМ.ПРО">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20" BackgroundColor="{StaticResource AccentColor}">
            <Label Text="КРЕПИМ.PRO" TextColor="White" FontSize="24" FontAttributes="Bold" />
            <Label Text="Надежный крепеж" TextColor="{StaticResource Sand}" FontSize="14" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <TabBar>
        <Tab Title="Главная" Icon="home_icon.png">
            <ShellContent ContentTemplate="{DataTemplate home:HomePage}" Route="home" />
        </Tab>
    </TabBar>

    <MenuItem Text="Выйти" Command="{Binding LogoutCommand}" />
    
</Shell>
