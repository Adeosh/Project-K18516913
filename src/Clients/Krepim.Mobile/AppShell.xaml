<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Krepim.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Krepim.Mobile"
    xmlns:home="clr-namespace:Krepim.Mobile.Features.Home.Views"
    xmlns:catalog="clr-namespace:Krepim.Mobile.Features.Catalog.Views"
    xmlns:basket="clr-namespace:Krepim.Mobile.Features.Basket.Views"
    xmlns:profile="clr-namespace:Krepim.Mobile.Features.Profile.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{StaticResource Sand}"
    Shell.TabBarForegroundColor="{StaticResource AccentColor}"
    Shell.TabBarTitleColor="{StaticResource AccentColor}"
    Shell.TabBarUnselectedColor="{StaticResource Espresso}">

    <TabBar>
        <Tab Title="Главная" Icon="home.png">
            <ShellContent ContentTemplate="{DataTemplate home:HomePage}" Route="home" />
        </Tab>

        <Tab Title="Каталог" Icon="catalog.png">
            <ShellContent ContentTemplate="{DataTemplate catalog:CatalogPage}" Route="catalog" />
        </Tab>

        <Tab Title="Корзина" Icon="basket.png">
            <ShellContent ContentTemplate="{DataTemplate basket:BasketPage}" Route="basket" />
        </Tab>

        <Tab Title="Кабинет" Icon="profile.png">
            <ShellContent ContentTemplate="{DataTemplate profile:ProfilePage}" Route="profile" />
        </Tab>
    </TabBar>

</Shell>
