{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "AppHostConfiguration": {
    "UseVolumes": true,
    "UseDedicatedPorts": true,
    "Postgres": {
      "ImageTag": "17.2",
      "Port": 15432,
      "UsePgWeb": true
    },
    "Mongo": {
      "ImageTag": "8.0",
      "UseExpress": true
    }
  }
}