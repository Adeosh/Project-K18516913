{
  "openapi": "3.1.1",
  "info": {
    "title": "Krepim.Basket.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:61484"
    },
    {
      "url": "http://localhost:61485"
    }
  ],
  "paths": {
    "/api/basket": {
      "get": {
        "tags": [
          "Basket"
        ],
        "operationId": "GetBasket",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Basket"
        ],
        "operationId": "ClearBasket",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/basket/items": {
      "post": {
        "tags": [
          "Basket"
        ],
        "operationId": "AddItemToBasket",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { }
              }
            }
          }
        }
      }
    },
    "/api/basket/items/{productId}": {
      "delete": {
        "tags": [
          "Basket"
        ],
        "operationId": "RemoveItemFromBasket",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { }
              }
            }
          }
        }
      }
    },
    "/api/basket/checkout": {
      "post": {
        "tags": [
          "Basket"
        ],
        "operationId": "CheckoutBasket",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddItemRequest": {
        "required": [
          "productId",
          "productName",
          "sku",
          "unitPrice",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "productName": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "unitPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CheckoutRequest": {
        "required": [
          "city",
          "street",
          "zipCode"
        ],
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "zipCode": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Basket"
    }
  ]
}