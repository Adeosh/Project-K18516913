{
  "openapi": "3.1.1",
  "info": {
    "title": "Krepim.Ordering.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:59926"
    },
    {
      "url": "http://localhost:59927"
    }
  ],
  "paths": {
    "/api/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "GetMyOrders",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultOfListOfOrderModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ErrorType"
          }
        }
      },
      "ErrorType": {
        "type": "integer"
      },
      "OrderItemModel": {
        "required": [
          "productId",
          "unitPrice",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "unitPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "OrderModel": {
        "required": [
          "id",
          "status",
          "totalPrice",
          "city",
          "street",
          "zipCode",
          "createdAt",
          "items"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "totalPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "city": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "zipCode": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemModel"
            }
          }
        }
      },
      "ResultOfListOfOrderModel": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
          "isFailure": {
            "type": "boolean"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          },
          "value": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/OrderModel"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Orders"
    }
  ]
}