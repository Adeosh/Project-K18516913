{
  "openapi": "3.1.1",
  "info": {
    "title": "Krepim.Payment.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:50632"
    },
    {
      "url": "http://localhost:50638"
    }
  ],
  "paths": {
    "/api/payments/{orderId}/url": {
      "get": {
        "tags": [
          "Payments"
        ],
        "operationId": "GetPaymentUrl",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultOfstring"
                }
              }
            }
          }
        }
      }
    },
    "/api/payments/webhook/mock": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Прием тестовых вебхуков для симуляции оплаты",
        "operationId": "MockWebhook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MockWebhookRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ErrorType"
          }
        }
      },
      "ErrorType": {
        "type": "integer"
      },
      "MockWebhookRequest": {
        "required": [
          "transactionId",
          "status"
        ],
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "errorMessage": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PaymentStatus": {
        "enum": [
          "Pending",
          "Succeeded",
          "Failed",
          "Refunded"
        ]
      },
      "ResultOfstring": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
          "isFailure": {
            "type": "boolean"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          },
          "value": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Payments"
    },
    {
      "name": "Webhooks"
    }
  ]
}