{
  "openapi": "3.1.1",
  "info": {
    "title": "Krepim.Inventory.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:53018"
    },
    {
      "url": "http://localhost:53020"
    }
  ],
  "paths": {
    "/api/inventory/{productId}": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "operationId": "GetStock",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultOfStockDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/inventory/credit": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "operationId": "CreditStock",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreditStockCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreditStockCommand": {
        "required": [
          "productId",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ErrorType"
          }
        }
      },
      "ErrorType": {
        "type": "integer"
      },
      "Result": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
          "isFailure": {
            "type": "boolean"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "ResultOfStockDto": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
          "isFailure": {
            "type": "boolean"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          },
          "value": {
            "$ref": "#/components/schemas/StockDto"
          }
        }
      },
      "StockDto": {
        "required": [
          "productId",
          "availableQuantity"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "availableQuantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Inventory"
    }
  ]
}